{
  "name": "pdf-probe",
  "version": "0.2.0",
  "description": "A small, fail-closed reader for untrusted PDFs: page count, effective page sizes, and structural flags. WebAssembly and native FFI for Node, Bun, and browsers.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polybot-platform/pdf-probe.git"
  },
  "keywords": [
    "pdf",
    "page-count",
    "page-size",
    "wasm",
    "ffi",
    "untrusted-input"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pdf_probe.wasm": "./dist/pdf_probe.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "homepage": "https://github.com/polybot-platform/pdf-probe#readme",
  "bugs": {
    "url": "https://github.com/polybot-platform/pdf-probe/issues"
  }
}
