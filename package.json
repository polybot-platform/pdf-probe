{
  "name": "pdf-probe-tools",
  "private": true,
  "type": "module",
  "description": "Test corpus generators and the differential test against pdf.js. Not the library.",
  "scripts": {
    "corpus": "bun run corpus/generate-classic.ts corpus/out && bun run corpus/generate-modern.ts corpus/out",
    "reference": "bun run tools/run-reference.ts corpus/out corpus/reference-results.json",
    "diff": "bun run tools/diff-results.ts corpus/expected-pdfjs.json",
    "poppler": "bun run tools/run-poppler.ts corpus/out corpus/poppler-results.json",
    "samples": "bun run tools/fetch-pdfjs-samples.ts",
    "samples:reference": "bun run tools/run-reference.ts corpus/pdfjs-samples/repo/test/pdfs corpus/pdfjs-samples/reference-results.json",
    "samples:poppler": "bun run tools/run-poppler.ts corpus/pdfjs-samples/repo/test/pdfs corpus/pdfjs-samples/poppler-results.json",
    "samples:diff": "bun run tools/diff-results.ts corpus/pdfjs-samples/reference-results.json corpus/pdfjs-samples/poppler-results.json"
  },
  "devDependencies": {
    "unpdf": "2.1.0"
  }
}
